{
  "manifest_version": 3,
  "name": "Auto Overlay Translator",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage" 
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"]
    }
  ]
}
